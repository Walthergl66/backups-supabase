# ===== Backups y Monitoreo de Supabase - Plantilla de entorno =====
# Copia este archivo a `backend/.env` y completa los valores.

# ------------------------------------------------------------------
# Token del bot de Telegram (crea uno con @BotFather).
# ------------------------------------------------------------------
BOT_TOKEN=

# ------------------------------------------------------------------
# Clave maestra de cifrado (Fernet). Se usa para encriptar en reposo
# los PAT y las cadenas de conexión. GENERA UNA PROPIA:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la pierdes o la cambias, los datos ya cifrados no se podrán descifrar.
# ------------------------------------------------------------------
ENCRYPTION_KEY=

# ------------------------------------------------------------------
# Clave de cifrado de los ARCHIVOS DE BACKUP (.dump/.sql) en disco (Fernet).
# Debe ser DISTINTA de ENCRYPTION_KEY. Sin ella los backups no se cifran:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la cambias, los backups ya cifrados no se podrán descifrar.
# ------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=

# ------------------------------------------------------------------
# Credenciales del usuario ADMIN inicial de la interfaz web.
# Solo se aplican la primera vez que arranca, cuando NO existe ningún
# usuario web en la base de datos. Después se gestiona desde la web.
# ------------------------------------------------------------------
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Secreto de firma de los tokens JWT de sesión (HS256). Genera uno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Es la clave HMAC con la que se firman los access tokens. Si la cambias,
# los tokens emitidos antes dejarán de ser válidos.
# ------------------------------------------------------------------
SESSION_SECRET=

# ------------------------------------------------------------------
# Almacenamiento local de la base de datos y los backups.
# Dentro de Docker estos valores apuntan al volumen `./data`.
# ------------------------------------------------------------------
DB_PATH=/data/backups.db
BACKUP_DIR=/data/backups

# ------------------------------------------------------------------
# Cantidad de backups que se conservan por proyecto (rotación).
# ------------------------------------------------------------------
BACKUP_KEEP_COUNT=10

# ------------------------------------------------------------------
# Tiempo máximo (segundos) que puede tardar pg_dump antes de abortar.
# ------------------------------------------------------------------
BACKUP_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------
# API (dentro del contenedor Docker se expone por 8080, solo interno).
# Orígenes permitidos para CORS (separados por coma). Solo el panel de la
# propia máquina (mismo origen) es lo normal; añade aquí la URL .ts.net de
# Tailscale si accedes desde otro origen.
# ------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------
# Documentación de la API (Swagger/ReDoc). En producción se recomienda
# dejarla DESACTIVADA (false): evita dar visibilidad a los endpoints.
# ------------------------------------------------------------------
WEB_DOCS_ENABLED=false

# ------------------------------------------------------------------
# Iteraciones PBKDF2-SHA256 para contraseñas web (estándar OWASP: 600000).
# Los hashes existentes se re-calculan automáticamente en su siguiente
# login correcto (migración sin fricción).
# ------------------------------------------------------------------
PBKDF2_ITERATIONS=600000

# ------------------------------------------------------------------
# Sesión web (M6): access token JWT corto en memoria del navegador +
# refresh token en cookie HttpOnly (inaccesible a JS). El access token
# expira en JWT_TTL_MINUTES; el refresh, en REFRESH_TTL_DAYS (se rota
# en cada uso y mantiene la sesión deslizante).
# ------------------------------------------------------------------
JWT_TTL_MINUTES=60
REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------
# Mini-WAF por IP (A5): si una IP supera THROTTLE_MAX_REQUESTS hacia
# /api/* en una ventana de THROTTLE_WINDOW_SECONDS segundos, se bloquea
# THROTTLE_BLOCK_SECONDS segundos y se alerta a los admins por Telegram.
# ------------------------------------------------------------------
THROTTLE_MAX_REQUESTS=120
THROTTLE_WINDOW_SECONDS=60
THROTTLE_BLOCK_SECONDS=120

# ------------------------------------------------------------------
# Self-backup de la propia base del panel (la BD con las cuentas, PAT
# cifrados y configuración). Se cifra con BACKUP_ENCRYPTION_KEY.
# SELF_BACKUP_TIME es la hora HH:MM del día en la zona SELF_BACKUP_TZ
# (por defecto UTC). Con SELF_BACKUP_TELEGRAM=on se envía el más
# reciente a los admins de Telegram tras cada copia.
# ------------------------------------------------------------------
SELF_BACKUP_DIR=/data/backups/self
SELF_BACKUP_KEEP_COUNT=10
SELF_BACKUP_TIME=03:00
SELF_BACKUP_TZ=UTC
SELF_BACKUP_TELEGRAM=on